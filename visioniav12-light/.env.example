# Core
APP_ENV=production
APP_NAME=INNOVATION VISION IA V12 LIGHT
APP_SECRET_KEY=CHANGE_ME_64_RANDOM_CHARS
JWT_EXPIRE_MINUTES=480
TZ=America/Sao_Paulo

# First administrator — generated locally by scripts/bootstrap-production.sh
INITIAL_ADMIN_EMAIL=admin@innovationrptelecom.com.br
INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Initial client — use a real condominium name from gateways.yaml
INITIAL_CLIENT_EMAIL=cliente@innovationrptelecom.com.br
INITIAL_CLIENT_PASSWORD=CHANGE_ME_CLIENT_PASSWORD
INITIAL_CLIENT_CONDO_SCOPE=CHANGE_ME_CONDO_NAME
ACCESS_BOOTSTRAP_STATUS_FILE=/tmp/vision-light-access-bootstrap.json

# PostgreSQL
POSTGRES_DB=vision_light
POSTGRES_USER=vision_light
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql+psycopg://vision_light:CHANGE_ME_DB_PASSWORD@postgres:5432/vision_light

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PREFIX=vl:

# MinIO
MINIO_ROOT_USER=visionlight
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_BUCKET=vision-light
MEDIA_RETENTION_DAYS=7

# Detector
YOLO_MODEL=/models/yolo11n.pt
YOLO_POSE_MODEL=/models/yolo11n-pose.pt
YOLO_DEVICE=0
YOLO_IMGSZ=640
YOLO_BATCH_SIZE=16
YOLO_BATCH_WAIT_MS=120
YOLO_CONFIDENCE=0.25
MAX_FRAME_AGE_S=10
POSE_EVERY_N=5
DETECT_FPS=2
DETECT_WIDTH=960
DETECT_HEIGHT=540
RULE_REFRESH_S=5

# Camera health and latest frame for the ROI editor
CAMERA_ONLINE_MAX_AGE_S=20
LATEST_FRAME_TTL_S=30
LATEST_FRAME_UI_INTERVAL_S=5

# Evidence
CLIP_PRE_SECONDS=5
CLIP_POST_SECONDS=10
CLIP_TARGET_SECONDS=15
FFPROBE_DURATION_MIN=14.5
FFPROBE_DURATION_MAX=15.5

# Existing Wine/T2U gateway integration
# This must point to a gateway API or adapter reachable from the new VM.
GATEWAY_REGISTRY_FILE=/config/gateways.yaml
GATEWAY_AUTH_TOKEN_FILE=/run/secrets/gateway_auth_token
GATEWAY_CONNECT_TIMEOUT_S=5
GATEWAY_READ_TIMEOUT_S=35

# Web
HTTP_BIND=0.0.0.0
HTTP_PORT=8080
PUBLIC_BASE_URL=https://visioniav12.innovationrptelecom.com.br
ADMIN_PATH=/admin
CLIENT_PATH=/portal

# Cloudflare — credentials stay outside Git
CLOUDFLARE_TUNNEL_NAME=visionia
CLOUDFLARE_TUNNEL_UUID=b80c0e8d-4ad4-4693-90e1-76b1259d35f2
CLOUDFLARE_TOKEN_FILE=/run/secrets/cloudflared/visionia.token

# Safety
PRODUCTION_WRITER_ENABLED=false
ALLOW_MANUAL_EVENT_INSERT=false
GLOBAL_WINE_T2U_RESTART_ALLOWED=false
