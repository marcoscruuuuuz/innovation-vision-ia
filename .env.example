COMPOSE_PROJECT_NAME=innovation-vision-ia
TZ=America/Sao_Paulo

POSTGRES_DB=vision
POSTGRES_USER=vision
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES

MINIO_ROOT_USER=visionminio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO
MINIO_EVIDENCE_BUCKET=vision-evidence

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA

# Bootstrap is only for first admin access/token issuance. Rotate/remove after creating admin API tokens.
VISION_BOOTSTRAP_ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN

VISION_API_PORT=8080
VISION_ADMIN_PORT=8083
VISION_CLIENT_PORT=8084
VISION_INGESTION_PORT=8100
VISION_P2P_API_PORT=8090
VISION_STREAMBROKER_PORT=8091
VISION_FAILOVER_PORT=8092

REDIS_MAXMEMORY=2gb
REDIS_MAXMEMORY_POLICY=allkeys-lru

INGESTION_REDIS_STREAM=vision:ingestion:events
INGESTION_MAX_BODY_BYTES=12582912
INGESTION_MAX_SNAPSHOT_BYTES=10485760
INGESTION_HMAC_KEYS_JSON={}

VISION_DETECTOR_BACKEND=disabled
DETECTOR_HTTP_URL=
DETECTOR_MODEL_KEY=
DETECTOR_MODEL_VERSION=
DETECTOR_HTTP_TIMEOUT=20

VISION_RETENTION_DAYS=7
RETENTION_INTERVAL_SECONDS=86400

EVOLUTION_ENABLED=false
EVOLUTION_API_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_SEND_PATH_TEMPLATE=/message/sendText/{instance}
EVOLUTION_TIMEOUT=15

# Final P2P/Wine code is available behind --profile p2p. Real execution remains disabled until the authorized bridge is installed and homologated.
P2P_SDK_PORT_START=21000
P2P_SDK_PORT_END=21999
P2P_RTSP_PORT_START=22000
P2P_RTSP_PORT_END=22999
P2P_LEASE_SECONDS=120
P2P_MINIMUM_PROBE_FRAMES=3
STREAMBROKER_MIN_PROBE_FRAMES=3
STREAMBROKER_FAILURE_THRESHOLD=3
STREAMBROKER_RECOVERY_THRESHOLD=3
STREAMBROKER_FAILOVER_COOLDOWN_SECONDS=120
FAILOVER_REQUEST_TIMEOUT=45
INTELBRAS_VENDOR_ADAPTER_ENABLED=false
INTELBRAS_VENDOR_ADAPTER_COMMAND=/vendor/intelbras/vision-intelbras-adapter
INTELBRAS_VENDOR_ADAPTER_TIMEOUT=30
